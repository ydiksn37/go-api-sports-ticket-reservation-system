# データベース接続情報
# 環境変数を変更する場合
# POSTGRES_* の3つの値と、DATABASE_URL 内の対応する値は必ず完全に一致させる
# DATABASE_URL の `@db:5432` と `?sslmode=disable` はインフラ構成上の固定値
# `yukusano` や `road_to_dena` 以外の値に変更する場合は、以下のファイルも修正する必要がある
#  - compose.yaml : healthcheck コマンド (pg_isready -U yukusano)
#  - Makefile     : exec-db コマンド (psql -U yukusano -d road_to_dena)

POSTGRES_USER=yukusano
POSTGRES_PASSWORD=secret_password
POSTGRES_DB=road_to_dena
DATABASE_URL=postgres://yukusano:secret_password@db:5432/road_to_dena?sslmode=disable
JWT_SECRET=local-dev-secret
JWT_ISSUER=road-to-dena
JWT_AUDIENCE=road-to-dena-client
COOKIE_DOMAIN=
