# ローカル開発用データベース接続情報
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sports_ticket_reservation
DATABASE_URL=postgres://postgres:postgres@db:5432/sports_ticket_reservation?sslmode=disable

# JWT_SECRET は公開環境では十分に長いランダム値へ変更してください
JWT_SECRET=local-development-secret-change-me
JWT_ISSUER=sports-ticket-reservation-api
JWT_AUDIENCE=sports-ticket-reservation-client
COOKIE_DOMAIN=
